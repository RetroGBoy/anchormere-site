{
  "version": 1,
  "updated": "2026-11-09",
  "site": "https://anchormere.com",
  "description": "Anchormere 站点模块化工作区注册表。这是分区、增量与交接制度的唯一事实来源，任何模型/会话/机器接手工作前先读本文件，无需依赖聊天记录。匹配规则：modules 数组自上而下，第一个命中的模块即该文件归属；同一文件只归属一个模块。",
  "unassigned_is_error": true,
  "state_file": "scripts/module_state.json",
  "handoff_doc": "WORKFLOW.md",
  "principles": [
    "先声明模块，再动手：任何改动必须能对应到一个 module id",
    "无变更不落盘：生成器统一走 io_util.write_if_changed，字节相同即跳过写盘与提交",
    "无需求不扫描：workarea.py 只对脏模块及其依赖闭包做读取、重建与校验",
    "没问题的不做变动：policy=manual / frozen 的模块在自动流程中只读不写",
    "核心目标不变：protected 列表内的文件禁止自动重建，改动须显式声明",
    "认知落在仓库：状态、制度、依赖全部写入 modules.json / module_state.json / WORKFLOW.md，换模型不丢"
  ],
  "protected": {
    "rule": "自动重建与批量脚本禁止写入；如需改动必须显式指定目标文件并在提交信息说明。核心目标=引流、询盘、关键词覆盖、转化路径。",
    "paths": [
      "contact.html",
      "assets/consent.js",
      "assets/consent.css",
      "assets/lang.js",
      "index.html",
      "_headers",
      "robots.txt"
    ]
  },
  "policies": {
    "auto": "由生成器产出，允许在依赖变更时自动重建",
    "scheduled": "仅由每日定时 CI 处理；增量流程默认跳过，不扫描、不校验（没有需求不重新扫描）",
    "manual": "人工维护页，自动流程只读不写，仅做校验",
    "frozen": "归档/大文件，默认连哈希都不计算，除非显式 --include-frozen",
    "config": "由专用生成器重建的站点级配置",
    "governance": "制度文件本身，变更只触发状态重算，不触发页面重建"
  },
  "verify": {
    "local": "逐页检查：hreflang / 中文版本声明 / canonical / JSON-LD / Organization 一致性 / E-E-A-T / wordCount / clean URL / lang / Article @id。增量模式仅对脏模块的页面执行。",
    "global": "全站不变量：孤儿页 / sitemap lastmod / robots AI 爬虫 / IndexNow / GSC-Bing 验证 / 实体类型覆盖 / 无 Product-Offer 零售实体 / meta keywords ≤200 字符 / FAQPage speakable / 公开案例来源 URL 明文与免责声明 / 长尾页差异化结构不变量 / 编辑标准页 E-E-A-T 边界。始终执行一次（基于单次读取缓存，开销极小）。",
    "full_flag": "--all",
    "gate": "verify_seo.py 退出码 1 = FAIL 阻断推送；2 = WARN 提示；0 = PASS"
  },
  "modules": [
    {
      "id": "governance",
      "title": "制度与工作区驱动器",
      "policy": "governance",
      "paths": [
